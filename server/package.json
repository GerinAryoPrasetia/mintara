{
  "name": "mintara",
  "version": "1.0.0",
  "description": "Web-based API response comparison tool for migration validation",
  "keywords": ["API", "comparison", "diff", "migration", "testing"],
  "homepage": "https://github.com/GerinAryoPrasetia/mintara#readme",
  "bugs": {
    "url": "https://github.com/GerinAryoPrasetia/mintara/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GerinAryoPrasetia/mintara.git"
  },
  "license": "ISC",
  "author": "Gerin Aryo",
  "type": "module",
  "bin": {
    "mintara": "./bin/mintara.js"
  },
  "files": [
    "bin",
    "dist",
    "public"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "build": "node build.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ollama": "^0.6.3"
  },
  "devDependencies": {
    "@mintara/shared": "*",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/supertest": "^6.0.2",
    "esbuild": "^0.27.7",
    "supertest": "^7.0.0",
    "tsx": "^4.11.2",
    "vitest": "^1.6.0"
  }
}
